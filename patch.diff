+// Сейлз-промпт: ответы по сути + всегда подводят к лидам
+async function answerAI(text) {
+  const systemMsg = {
+    role: 'system',
+    content:
+      "You are AI24Solutions Sales Consultant. Answer briefly, practical, no fluff. " +
+      "Audience: business owners (experts, salons/cosmetology, fitness/wellness, therapists, freelancers, B2B services, e-commerce). " +
+      "Goal: convert dialog into lead for AI24Solutions. " +
+      "Rules: 1) Give clear, valuable answer. 2) Then 1-2 short CTAs: offer PULSE AI-seller demo and suggest to leave contact. " +
+      "3) Never argue, be supportive. 4) If user shares phone or @username — that's a lead."
+  };
+  const userMsg = { role: 'user', content: text };
+
+  const res = await openai.chat.completions.create({
+    model: 'gpt-4o',
+    max_tokens: 500,
+    messages: [systemMsg, userMsg]
+  });
   return res.choices[0]?.message?.content || 'Не удалось получить ответ.';
 }

+// распознавание контакта в свободном тексте
+function extractContact(text) {
+  if (!text) return null;
+  const t = text.trim();
+  const at = t.match(/@([a-zA-Z0-9_]{3,})/);
+  if (at) return `@${at[1]}`;
+  const phone = t
+    .replace(/[^\d+]/g, '')
+    .match(/(\+?\d{10,15})/);
+  if (phone) return phone[1];
+  return null;
+}
