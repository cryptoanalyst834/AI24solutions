 // ==== AI Q&A
 async function answerAI(text) {
   const res = await openai.chat.completions.create({
     model: 'gpt-4o',
     max_tokens: 800,
     messages: [{ role: 'user', content: text }]
   });
   return res.choices[0]?.message?.content || 'Не удалось получить ответ.';
 }
 
